{
  "name": "@password2d/vue",
  "version": "1.0.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "node_modules/@password2d/core"
  ],
  "scripts": {
    "build": "tsup",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "build:core": "npm --prefix ../core run build",
    "prepack": "npm run build:core && npm run build && rm -rf node_modules/@password2d/core && mkdir -p node_modules/@password2d/core && cp ../core/package.json node_modules/@password2d/core/ && cp ../core/tsconfig.json node_modules/@password2d/core/ && cp -r ../core/dist node_modules/@password2d/core/ && cp -r ../core/src node_modules/@password2d/core/"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@password2d/core": "file:./node_modules/@password2d/core",
    "vue": ">=3.3.0"
  },
  "bundledDependencies": [
    "@password2d/core"
  ],
  "devDependencies": {
    "vue": "^3.3.0",
    "@types/jest": "^29.5.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/vue3-jest": "^29.2.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0",
    "vite": "^4.0.0",
    "@vitejs/plugin-vue": "^4.0.0",
    "vue-tsc": "^1.8.0",
    "vite-plugin-dts": "^3.7.0",
    "tsup": "^8.5.0",
    "unplugin-vue": "^5.0.0"
  }
  ,
  "pretest": "npm --prefix ../core run build"
}