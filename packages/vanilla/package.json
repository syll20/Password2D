{
  "name": "@password2d/vanilla",
  "version": "1.1.0",
  "description": "Vanilla TypeScript implementation of Password2D",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs,iife --dts --global-name Password2D",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "password2d",
    "vanilla",
    "typescript"
  ],
  "author": "syll20",
  "license": "MIT",
  "dependencies": {
    "@password2d/core": "^1.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.0"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "pretest": "npm --prefix ../core run build"
}